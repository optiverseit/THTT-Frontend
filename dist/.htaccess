# Strictly block any environment files from direct HTTP access
<FilesMatch "^(\.env|env\.)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  # Prevent directory indexing (fixes LiteSpeed "Name Last Modified Size Directory" listing)
  Options -Indexes
  DirectoryIndex index.html index.php

  RewriteEngine On
  RewriteBase /

  # Email dispatcher API route for cPanel
  RewriteRule ^api/send-email/?$ send-email.php [L,QSA]
  RewriteRule ^api/send-email\.php$ send-email.php [L,QSA]

  # Runtime Environment Config route for cPanel
  RewriteRule ^env-config\.js$ env-config.php [L]

  # Dynamic Social Share Bridge route
  RewriteRule ^share/?$ share.php [L,QSA]

  # Route social media crawlers (Facebook, WhatsApp, Twitter, LinkedIn, etc.)
  # requesting detail pages directly to share.php to generate rich page-specific previews
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|Pinterest|SkypeUriPreview|Slackbot) [NC]
  RewriteRule ^(visa-details|details|hotel-detail|vehicle-detail|work-permit-details|service|documentation|blog|video|insurance-details)/([0-9a-zA-Z_-]+)/?$ share.php?type=$1&id=$2 [L,QSA]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
