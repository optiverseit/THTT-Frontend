# ------------------------------------------------------------------------------
# 1. SECURITY HEADERS: Anti-Phishing, Anti-Clickjacking & Data Protection
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Anti-Clickjacking: Prevent framing in phishing/malicious sites
  Header always set X-Frame-Options "SAMEORIGIN"

  # Prevent MIME-type sniffing vulnerabilities
  Header always set X-Content-Type-Options "nosniff"

  # Cross-Site Scripting (XSS) filter protection
  Header always set X-XSS-Protection "1; mode=block"

  # Referrer Policy: Protect user privacy & prevent referrer leakage
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Restrict camera, microphone & geolocation access
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Strict Transport Security (HSTS): Enforce HTTPS & prevent SSL stripping
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# ------------------------------------------------------------------------------
# 2. BLOCK SENSITIVE SERVER FILES & ENVIRONMENT CONFIGS
# ------------------------------------------------------------------------------
<FilesMatch "^(\.env|env\.|\.git|\.htaccess|\.htpasswd|composer\.|package(-lock)?\.json|tsconfig\.json|vite\.config|\.sql|\.log|\.bak|\.ini)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  # Prevent directory indexing (fixes LiteSpeed "Name Last Modified Size Directory" listing)
  Options -Indexes
  DirectoryIndex index.html index.php

  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------------------------
  # CANONICAL REDIRECT: Enforce HTTPS & Non-WWW Domain
  # Consolidates all search ranking equity to https://triphimalaya.com.np
  # ----------------------------------------------------------------------------
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.triphimalaya\.com\.np$ [NC]
  RewriteRule ^(.*)$ https://triphimalaya.com.np/$1 [R=301,L]

  # ----------------------------------------------------------------------------
  # 3. ANTI-SPAM & MALICIOUS BOT BLOCKER
  # Blocks automated vulnerability scanners, exploit scrapers & bad bots
  # (Legitimate SEO audit crawlers like Semrush and Ahrefs are permitted)
  # ----------------------------------------------------------------------------
  RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|wpscan|libwww-perl|HTTrack|masscan|zgrab|nmap|acunetix|havij) [NC,OR]
  RewriteCond %{HTTP_USER_AGENT} (BLEXBot|DotBot|MJ12bot) [NC]
  RewriteRule .* - [F,L]

  # ----------------------------------------------------------------------------
  # 4. ANTI-PHISHING, SQL INJECTION & XSS ATTACK MITIGATION
  # Blocks malicious script injection, directory traversal and query exploits
  # ----------------------------------------------------------------------------
  RewriteCond %{QUERY_STRING} (<|%3C).*script.*(>|%3E) [NC,OR]
  RewriteCond %{QUERY_STRING} (UNION|SELECT|INSERT|UPDATE|DELETE|DROP|CAST|DECLARE)\s [NC,OR]
  RewriteCond %{QUERY_STRING} (base64_encode|globals|request) [NC,OR]
  RewriteCond %{QUERY_STRING} (\.\./|%2e%2e%2f) [NC]
  RewriteRule .* - [F,L]

  # Email dispatcher API route for cPanel
  RewriteRule ^api/send-email/?$ send-email.php [L,QSA]
  RewriteRule ^api/send-email\.php$ send-email.php [L,QSA]

  # Runtime Environment Config route for cPanel
  RewriteRule ^env-config\.js$ env-config.php [L]

  # Dynamic Social Share Bridge route
  RewriteRule ^share/?$ share.php [L,QSA]

  # Route social media crawlers (Facebook, WhatsApp, Twitter, LinkedIn, etc.)
  # requesting detail pages directly to share.php to generate rich page-specific previews
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|Pinterest|SkypeUriPreview|Slackbot|Googlebot|bingbot|DuckDuckBot|Baiduspider|YandexBot|Applebot|Sogou) [NC]
  RewriteRule ^service/heli-services/([0-9a-zA-Z_-]+)/?$ share.php?type=heli-services&id=$1 [L,QSA]

  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|Pinterest|SkypeUriPreview|Slackbot|Googlebot|bingbot|DuckDuckBot|Baiduspider|YandexBot|Applebot|Sogou) [NC]
  RewriteRule ^service/travel-insurance/([0-9a-zA-Z_-]+)/?$ share.php?type=insurance-details&id=$1 [L,QSA]

  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|Pinterest|SkypeUriPreview|Slackbot|Googlebot|bingbot|DuckDuckBot|Baiduspider|YandexBot|Applebot|Sogou) [NC]
  RewriteRule ^(visa-details|details|packages|hotel-details|hotel-detail|vehicle-details|vehicle-detail|permit-details|work-permit-details|documentation|documents|blog|blog-details|watch|video|insurance-details|insurance-detail)/([0-9a-zA-Z_-]+)/?$ share.php?type=$1&id=$2 [L,QSA]

  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|Pinterest|SkypeUriPreview|Slackbot|Googlebot|bingbot|DuckDuckBot|Baiduspider|YandexBot|Applebot|Sogou) [NC]
  RewriteRule ^service/([0-9a-zA-Z_-]+)/?$ share.php?type=service&id=$1 [L,QSA]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
